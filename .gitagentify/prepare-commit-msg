#!/bin/bash
#
# prepare-commit-msg hook: enrich Copilot-authored commits with session metadata
# trailers so every commit can be traced back to the Copilot CLI session that
# produced it.
#
# Installed and wired by:  gitagentify activate
#
# Behaviour:
#   * Only fires when COPILOT_CLI=1 (leaves normal human commits untouched).
#   * Skips merge and squash commits.
#   * Idempotent: does nothing if a Copilot-Session-Id trailer is already present.
#   * Chains to a repo-local prepare-commit-msg.local in .git/hooks/ if present,
#     so this shared hook does not clobber machine-specific hooks.
#   * Resolves the model dynamically, most-authoritative source first:
#       1. COPILOT_MODEL env override
#       2. the latest session.model_change "newModel" in the session log
#          (tracks mid-session model switches - most current)
#       3. the "Using default model:" line in the session process log
#       4. the "model" field in ${COPILOT_HOME:-$HOME/.copilot}/settings.json
#     The session log dir is taken from AGENCY_LOG_SESSION_DIR.
#   * Merges trailers with git interpret-trailers so existing trailers such as
#     Co-authored-by are preserved.

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

# Chain to a repo-local hook first, if one exists, so we don't shadow it.
LOCAL_HOOK="$(git rev-parse --git-path hooks/prepare-commit-msg.local 2>/dev/null || true)"
if [ -n "${LOCAL_HOOK:-}" ] && [ -x "$LOCAL_HOOK" ]; then
  "$LOCAL_HOOK" "$@"
fi

# Only enrich commits created by the Copilot CLI.
if [ "${COPILOT_CLI:-}" != "1" ]; then
  exit 0
fi

# Skip merge / squash commits - their messages are generated by git.
case "$COMMIT_SOURCE" in
  merge|squash)
    exit 0
    ;;
esac

# Idempotency: bail if we already stamped this message.
if grep -qi '^Copilot-Session-Id:' "$COMMIT_MSG_FILE"; then
  exit 0
fi

# --- Gather metadata ---------------------------------------------------------

SESSION_ID="${COPILOT_AGENT_SESSION_ID:-${AGENCY_SESSION_ID:-}}"
CLI_VERSION="${COPILOT_CLI_BINARY_VERSION:-}"

# Resolve the model. Explicit override wins; otherwise mine the session logs
# (which reflect the actual live model, including mid-session switches), and
# only fall back to settings.json.
MODEL="${COPILOT_MODEL:-}"

if [ -z "$MODEL" ] && [ -n "${AGENCY_LOG_SESSION_DIR:-}" ] && [ -d "$AGENCY_LOG_SESSION_DIR" ]; then
  # 2. Latest session.model_change event: take the last "newModel":"..." seen.
  # '|| true' keeps a no-match grep (exit 1) from aborting the hook under 'set -e'/pipefail.
  MODEL="$(grep -rho '"newModel"[[:space:]]*:[[:space:]]*"[^"]*"' "$AGENCY_LOG_SESSION_DIR" 2>/dev/null \
    | sed 's/.*"\([^"]*\)"$/\1/' | tail -n1 || true)"

  # 3. Fall back to the "Using default model:" line in the process log.
  if [ -z "$MODEL" ]; then
    MODEL="$(grep -rho 'Using default model:[[:space:]]*[^[:space:]]*' "$AGENCY_LOG_SESSION_DIR" 2>/dev/null \
      | sed 's/.*:[[:space:]]*//' | tail -n1 || true)"
  fi
fi

# 4. Last resort: the "model" field in settings.json.
if [ -z "$MODEL" ]; then
  SETTINGS_FILE="${COPILOT_HOME:-$HOME/.copilot}/settings.json"
  if [ -f "$SETTINGS_FILE" ]; then
    MODEL="$(sed -n 's/.*"model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SETTINGS_FILE" | head -n1 || true)"
  fi
fi

# --- Apply trailers ----------------------------------------------------------

ARGS=()
[ -n "$SESSION_ID" ]  && ARGS+=(--trailer "Copilot-Session-Id: $SESSION_ID")
[ -n "$MODEL" ]       && ARGS+=(--trailer "Copilot-Model: $MODEL")
[ -n "$CLI_VERSION" ] && ARGS+=(--trailer "Copilot-CLI-Version: $CLI_VERSION")

# Guard on a non-empty array (safe under 'set -u' on older bash) and never let a
# failing interpret-trailers block the commit - this hook only *adds* metadata.
if [ "${#ARGS[@]}" -gt 0 ]; then
  git interpret-trailers --in-place "${ARGS[@]}" "$COMMIT_MSG_FILE" || true
fi

exit 0
